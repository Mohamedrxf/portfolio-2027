# Environment Variables Example
# Task 1.10 - Configure Environment Variables
#
# Copy this file to .env and fill in the actual values for your environment.
# Never commit .env files with real credentials to version control.
#
# Required variables:
# - All variables prefixed with VITE_ are available in the client-side code
# - Variables without VITE_ prefix are not available in the browser

# Application Information
# The name of the application
VITE_APP_NAME=Portfolio 2027

# The current version of the application
VITE_APP_VERSION=1.0.0

# API Configuration
# Base URL for API endpoints (if backend integration is added)
# Use empty string or placeholder if no backend is configured
VITE_API_URL=https://api.example.com

# Site Configuration
# The public URL where the site is deployed
# Used for SEO, social media links, and redirects
VITE_SITE_URL=https://yourportfolio.com

# Contact Information
# Primary contact email address for the portfolio
# Used in contact forms and footer links
VITE_CONTACT_EMAIL=contact@example.com

# Social Media Links
# GitHub profile URL
# Used in social links and footer
VITE_GITHUB_URL=https://github.com/yourusername

# LinkedIn profile URL
# Used in social links and footer
VITE_LINKEDIN_URL=https://linkedin.com/in/yourusername

# Optional Variables (not currently used but reserved for future use)
# VITE_TWITTER_URL=https://twitter.com/yourusername
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://your-sentry-dsn
